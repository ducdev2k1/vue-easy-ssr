{
  "name": "vue-easy-ssr-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter demo-basic dev",
    "dev:ssr": "pnpm --filter demo-basic dev:ssr",
    "build": "pnpm --filter vue-easy-ssr build && pnpm --filter demo-basic build",
    "build:plugin": "pnpm --filter vue-easy-ssr build",
    "build:demo": "pnpm --filter demo-basic build",
    "preview": "pnpm --filter demo-basic preview",
    "preview:ssr": "pnpm --filter demo-basic preview:ssr",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
